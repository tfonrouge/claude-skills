{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs-output",
  "title": "ACS advisory output",
  "$comment": "Single definition of the ACS output format. The validator in ../tools/acs_codex.py reads THIS file and enforces the dialect: type, required, properties, items, enum, pattern, minItems, maxItems, minLength, maxLength, additionalProperties. Annotations ($schema, $id, title, description, default, examples, $comment) are accepted and ignored. Any other keyword makes the run fail before Codex is called. Patterns must lie in the JSON Schema / Python re intersection: literals, character classes, anchors, and bounded repetition only. Every object lists all of its properties in `required`: the structured-output API rejects a schema that does not, so optional keys are expressed as arrays that may be empty, never as absent keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "not_verified",
    "items"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "not_verified": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "critique",
          "suggestion",
          "observations",
          "claims_to_verify",
          "inferences",
          "alternatives",
          "costs_and_risks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ACS-[0-9][0-9]$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "critique": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "observations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "evidence"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          },
          "claims_to_verify": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "how_to_check"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "how_to_check": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          },
          "inferences": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "from"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          },
          "alternatives": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "tradeoff"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "tradeoff": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          },
          "costs_and_risks": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "level"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
